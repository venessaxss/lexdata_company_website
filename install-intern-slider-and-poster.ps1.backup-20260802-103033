                    : "w-2.5 bg-white/35"
                }`}
              />
            ))}
          </div>

          <p className="text-xs font-black uppercase tracking-[0.2em] text-white/60">
            {String(activeIndex + 1).padStart(2, "0")} /{" "}
            {String(slides.length).padStart(2, "0")}
          </p>
        </div>
      </div>
    </section>
  );
}
