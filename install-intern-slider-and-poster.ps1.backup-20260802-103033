param(
    [string]$PosterPath = "",
    [string]$PosterName = "cisma-lexdata-intern-poster"
)

$ErrorActionPreference = "Stop"

$root = (Get-Location).Path
$packageJsonPath = Join-Path $root "package.json"
$homePagePath = Join-Path $root "components\IntegratedHomePage.tsx"

foreach ($requiredPath in @($packageJsonPath, $homePagePath)) {
    if (-not (Test-Path -LiteralPath $requiredPath)) {
        throw "Cannot find required file: $requiredPath`nRun this script from the project root."
    }
}

if (-not $PosterPath) {
    Add-Type -AssemblyName System.Windows.Forms

    $dialog = New-Object System.Windows.Forms.OpenFileDialog
    $dialog.Title = "Choose the CISMA and LexData internship poster"
    $dialog.Filter = "Poster images (*.png;*.jpg;*.jpeg;*.webp)|*.png;*.jpg;*.jpeg;*.webp"
    $dialog.Multiselect = $false

    if (
        $dialog.ShowDialog() -ne
        [System.Windows.Forms.DialogResult]::OK
    ) {
        Write-Host "Poster selection cancelled." -ForegroundColor Yellow
        exit 0
    }

    $PosterPath = $dialog.FileName
}

$resolvedPosterPath = (Resolve-Path -LiteralPath $PosterPath).Path
$extension = [System.IO.Path]::GetExtension(
    $resolvedPosterPath
).ToLowerInvariant()

if ($extension -notin @(".png", ".jpg", ".jpeg", ".webp")) {
    throw "Unsupported poster format: $extension. Use PNG, JPG, JPEG, or WebP."
}

$safePosterName = [regex]::Replace(
    $PosterName.ToLowerInvariant(),
    "[^a-z0-9_-]+",
    "-"
).Trim("-")

if (-not $safePosterName) {
    $safePosterName = "cisma-lexdata-intern-poster"
}

$timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
$backupRoot = Join-Path $root "_backups\intern-slider-poster-$timestamp"
$utf8 = New-Object System.Text.UTF8Encoding($false)

$contentPath = Join-Path $root "content\internHiring.ts"
$componentPath = Join-Path $root "components\InternHiringSlider.tsx"
$detailsPath = Join-Path $root "app\careers\internship\page.tsx"
$posterDirectory = Join-Path $root "public\posters"
$posterFileName = "$safePosterName$extension"
$posterDestination = Join-Path $posterDirectory $posterFileName
$publicPosterPath = "/posters/$posterFileName"

function Backup-File {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        return
    }

    $relativePath = $Path.Substring($root.Length).TrimStart("\", "/")
    $backupPath = Join-Path $backupRoot $relativePath

    New-Item -ItemType Directory `
        -Path (Split-Path -Parent $backupPath) `
        -Force |
        Out-Null

    Copy-Item `
        -LiteralPath $Path `
        -Destination $backupPath `
        -Force
}

function Write-Utf8 {
    param(
        [string]$Path,
        [string]$Content
    )

    $directory = Split-Path -Parent $Path

    if ($directory -and -not (Test-Path -LiteralPath $directory)) {
        New-Item -ItemType Directory `
            -Path $directory `
            -Force |
            Out-Null
    }

    [System.IO.File]::WriteAllText(
        $Path,
        $Content,
        $utf8
    )
}

foreach ($path in @(
    $homePagePath,
    $contentPath,
    $componentPath,
    $detailsPath
)) {
    Backup-File $path
}

New-Item -ItemType Directory `
    -Path $posterDirectory `
    -Force |
    Out-Null

Copy-Item `
    -LiteralPath $resolvedPosterPath `
    -Destination $posterDestination `
    -Force

