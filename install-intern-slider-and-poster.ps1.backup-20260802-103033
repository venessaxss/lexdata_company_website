          >
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>

        <div className="mt-8 flex flex-col items-center justify-between gap-5 sm:flex-row">
          <div className="flex items-center gap-2">
            {slides.map((slide, index) => (
